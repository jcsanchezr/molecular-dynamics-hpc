#!/usr/bin/env bash
# Run on ComputeNode as compute-user. No builds, package installations or Git commits.
set -Eeuo pipefail
export LC_ALL=C
marker="${XDG_CONFIG_HOME:-$HOME/.config}/molecular-dynamics-hpc/compute-node"
[[ -f "$marker" ]] || {
    echo 'Missing local compute-node authorization marker.' >&2
    exit 1
}
[[ "$(id -u)" != 0 ]] || {
    echo 'Run as a non-root user.' >&2
    exit 1
}
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root"
for tool in flock git docker; do command -v "$tool" >/dev/null; done
mkdir -p runs
exec 9>runs/.m1a.lock
flock -n 9 || { echo 'Another M1a runner holds the lock. Do not duplicate.'; exit 1; }
dkr=(sudo env -u DOCKER_HOST -u DOCKER_CONTEXT -u DOCKER_TLS \
     -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH -u BUILDX_BUILDER -u BUILDX_CONFIG \
     docker --host unix:///var/run/docker.sock)
image='molecular-dynamics-hpc:gmx2026.2-cpu'
expected='sha256:e6d20f0d1198056f9b842510d7e7e75bb4677a8597d268db78cc8fac49739e73'
actual="$("${dkr[@]}" image inspect "$image" --format '{{.Id}}')"
[[ "$actual" == "$expected" ]] || {
    echo 'Local image differs from verified M0. Stop and inspect; no rebuild.' >&2; exit 1;
}
active="$("${dkr[@]}" ps -q --filter 'label=com.docker.compose.project=molecular-dynamics-hpc')"
[[ -z "$active" ]] || { echo 'A project container is active. Stop here; do not duplicate.'; exit 1; }
compose=(./scripts/mdc --file "$root/compose.run.yaml")
"${compose[@]}" config --quiet
run="m1a-$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir "runs/$run"
trap 'rc=$?; printf "STOP (rc=%s). Keep all records in %s/runs/%s\n" "$rc" "$root" "$run" >&2; exit "$rc"' ERR
mkdir "runs/$run/source"
source_files=(compose.yaml compose.run.yaml scripts/mdc scripts/m1a \
    inputs/water-spce/topol.template.top inputs/water-spce/em.mdp \
    workflows/water-spce-em.sh analysis/check_water_em.py tests/test_water_em.py \
    docs/cases/water-spce.md)
cp --parents -- "${source_files[@]}" "runs/$run/source/"
( cd "runs/$run/source"; sha256sum "${source_files[@]}" > SHA256SUMS )
{
    printf 'StartedUTC=%s\nExecutionRole=compute-node\nImage=%s\nImageID=%s\n' \
        "$(date -u -Is)" "$image" "$actual"
    printf 'BaseCommit=%s\n' "$(git rev-parse HEAD)"
    printf 'Worktree snapshot follows (uncommitted files are copied into source/):\n'
    git status --short
} > "runs/$run/provenance.txt"
"${compose[@]}" config > "runs/$run/compose.resolved.yaml"
printf '\nExisting image only; NO build or pull. Run: %s/runs/%s\n' "$root" "$run"
"${compose[@]}" run --rm --no-deps --pull never -T cpu \
    bash "/workspace/runs/$run/source/workflows/water-spce-em.sh" "$run" \
    2>&1 | tee "runs/$run/run.log"
printf 'FinishedUTC=%s\n' "$(date -u -Is)" >> "runs/$run/provenance.txt"
sha256sum "runs/$run/source/SHA256SUMS"
printf '\n===== M1A RESULT =====\n'
cat "runs/$run/summary.json"
printf '\nRecords: %s/runs/%s\n' "$root" "$run"
printf 'No commit or GitHub push was performed.\n'
git status --short --branch
