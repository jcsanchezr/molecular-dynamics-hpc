FROM ubuntu:24.04 AS build
ARG GMX_VERSION=2026.2
ARG GMX_MD5=74c859cb7f53919f9c7760c287b43323
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build curl ca-certificates python3 \
    libfftw3-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp
RUN curl -fSL --retry 3 --connect-timeout 20 \
    "https://ftp.gromacs.org/gromacs/gromacs-${GMX_VERSION}.tar.gz" -o gromacs.tar.gz \
    && printf '%s  gromacs.tar.gz\n' "$GMX_MD5" | md5sum -c - \
    && mkdir -p /opt/provenance /src \
    && sha256sum gromacs.tar.gz > /opt/provenance/source.sha256 \
    && tar -xzf gromacs.tar.gz -C /src --strip-components=1
RUN cmake -S /src -B /build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/gromacs \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DGMX_GPU=OFF -DGMX_MPI=OFF \
    -DGMX_THREAD_MPI=ON -DGMX_OPENMP=ON \
    -DGMX_SIMD=AVX2_256 -DGMX_FFT_LIBRARY=fftw3 \
    -DGMX_BUILD_OWN_FFTW=OFF \
    -DGMX_EXTERNAL_BLAS=OFF -DGMX_EXTERNAL_LAPACK=OFF \
    -DGMXAPI=OFF \
    && cmake --build /build --parallel 1 \
    && cmake --install /build \
    && cp /build/CMakeCache.txt /opt/provenance/ \
    && dpkg-query -W > /opt/provenance/build-packages.tsv

FROM ubuntu:24.04 AS runtime
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates libfftw3-single3 libgomp1 libstdc++6 zlib1g python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/gromacs /opt/gromacs
COPY --from=build /opt/provenance /opt/provenance
ENV PATH="/opt/gromacs/bin:${PATH}"
RUN printf '/opt/gromacs/lib\n' > /etc/ld.so.conf.d/gromacs.conf \
    && ldconfig && gmx --version \
    && dpkg-query -W > /opt/provenance/runtime-packages.tsv
USER 65534:65534
WORKDIR /tmp
CMD ["gmx", "--version"]
