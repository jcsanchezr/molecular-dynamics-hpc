; M1a: initial overlap relaxation, NOT a time-dependent MD trajectory.
; Coarse acceptance threshold; not a precise energy minimum.
integrator              = steep
nsteps                  = 2000
emtol                   = 1000.0
emstep                  = 0.001
cutoff-scheme           = Verlet
nstlist                 = 10
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
pme-order               = 4
vdwtype                 = Cut-off
rvdw                   = 1.0
DispCorr                = EnerPres
pbc                     = xyz
; Water SETTLE constraints are supplied by spce.itp itself.
constraints             = none
nstenergy               = 1
nstlog                  = 50
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstxout-compressed      = 0
